{
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "Wan 2.2 I2V high-noise expert" }
  },
  "2": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "Wan 2.2 I2V low-noise expert" }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default" },
    "_meta": { "title": "Text encoder" }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "wan_2.1_vae.safetensors" },
    "_meta": { "title": "VAE" }
  },
  "5": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["1", 0],
      "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_high_noise.safetensors",
      "strength_model": "{{lightning_strength}}"
    },
    "_meta": { "title": "lightx2v 4-step (high)" }
  },
  "6": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["2", 0],
      "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors",
      "strength_model": "{{lightning_strength}}"
    },
    "_meta": { "title": "lightx2v 4-step (low)" }
  },
  "7": {
    "class_type": "ModelSamplingSD3",
    "inputs": { "model": ["5", 0], "shift": 5.0 },
    "_meta": { "title": "Shift (high)" }
  },
  "8": {
    "class_type": "ModelSamplingSD3",
    "inputs": { "model": ["6", 0], "shift": 5.0 },
    "_meta": { "title": "Shift (low)" }
  },
  "9": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["3", 0], "text": "{{positive}}" },
    "_meta": { "title": "Motion prompt" }
  },
  "10": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["3", 0], "text": "{{negative}}" },
    "_meta": { "title": "Negative" }
  },
  "11": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{start_image}}" },
    "_meta": { "title": "Gated keyframe" }
  },
  "12": {
    "class_type": "WanImageToVideo",
    "inputs": {
      "positive": ["9", 0],
      "negative": ["10", 0],
      "vae": ["4", 0],
      "start_image": ["11", 0],
      "width": "{{width}}",
      "height": "{{height}}",
      "length": "{{length}}",
      "batch_size": 1
    },
    "_meta": { "title": "Image to video" }
  },
  "13": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "model": ["7", 0],
      "add_noise": "enable",
      "noise_seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["12", 0],
      "negative": ["12", 1],
      "latent_image": ["12", 2],
      "start_at_step": 0,
      "end_at_step": "{{split_step}}",
      "return_with_leftover_noise": "enable"
    },
    "_meta": { "title": "Sampler (high-noise expert)" }
  },
  "14": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "model": ["8", 0],
      "add_noise": "disable",
      "noise_seed": 0,
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["12", 0],
      "negative": ["12", 1],
      "latent_image": ["13", 0],
      "start_at_step": "{{split_step}}",
      "end_at_step": 10000,
      "return_with_leftover_noise": "disable"
    },
    "_meta": { "title": "Sampler (low-noise expert)" }
  },
  "15": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["14", 0], "vae": ["4", 0] },
    "_meta": { "title": "Decode" }
  },
  "16": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["15", 0], "fps": "{{fps}}" },
    "_meta": { "title": "Frames to video" }
  },
  "17": {
    "class_type": "SaveVideo",
    "inputs": { "video": ["16", 0], "filename_prefix": "{{filename_prefix}}", "format": "auto", "codec": "auto" },
    "_meta": { "title": "Save clip" }
  }
}
